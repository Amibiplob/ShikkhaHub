# Browser-safe Supabase project settings; never place a service-role key in VITE_*.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Optional CLI migration connection only; never exposed to the browser.
# LOVABLE_DB_MIGRATION_URL=postgresql://...
