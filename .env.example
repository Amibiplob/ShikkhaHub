# Browser-safe Supabase project settings; never place a service-role key in VITE_*.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-only Edge Function examples: supabase/functions/.env.example
# Do not put AI or service-role credentials in this frontend environment.

# Optional non-secret flag; enable only after live-ice and an authenticated relay are configured.
VITE_LIVE_TURN_ENABLED=false
