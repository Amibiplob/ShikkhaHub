{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "supabase/functions/runtime.d.ts",
    "supabase/functions/_shared/*.ts",
    "supabase/functions/certificate-pdf/*.ts",
    "supabase/functions/support-contact/*.ts",
    "supabase/functions/course-assistant/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
