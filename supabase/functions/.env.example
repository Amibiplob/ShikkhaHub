# Server-only examples for an explicitly approved disposable Supabase target.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
# Never copy server credentials into VITE_* variables or commit real values.
APP_ALLOWED_ORIGINS=https://app.example.test
APP_PUBLIC_ORIGIN=https://app.example.test
SUPPORT_CHALLENGE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional assistant: configure an HTTPS SSE chat-completions endpoint and a stable model.
# Leave these unset to keep the assistant unavailable (HTTP 503).
AI_CHAT_COMPLETIONS_URL=https://provider.example.test/v1/chat/completions
AI_MODEL=REPLACE_WITH_SUPPORTED_STABLE_MODEL
AI_API_KEY=REPLACE_WITH_SERVER_ONLY_PROVIDER_KEY
